# =============================================================================
# e-MMS Frontend Environment Variables (.env.example)
# =============================================================================
# คัดลอกไฟล์นี้เป็น .env.local สำหรับรันทดสอบบนเครื่อง
# คำเตือนความปลอดภัย (Golden Rule 4.4):
# ห้ามใส่ SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, JWT_SECRET หรือ TELEGRAM_BOT_TOKEN
# ในไฟล์ฝั่ง Frontend เด็ดขาด ตัวแปรที่มีคำนำหน้า VITE_ จะถูกฝังลงใน Static Bundle สาธารณะ

VITE_API_BASE_URL=http://localhost:8080
