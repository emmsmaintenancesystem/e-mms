# =============================================================================
# e-MMS Backend Environment Variables Template (.env.example)
# =============================================================================
# คัดลอกไฟล์นี้เป็น .env สำหรับรันทดสอบบนเครื่อง (ห้ามนำไฟล์ .env จริงขึ้น Git เด็ดขาด)
# บน Google Cloud Run ให้ตั้งค่าตัวแปรเหล่านี้ในส่วน Variables & Secrets ของ Cloud Run

# --- Server Settings ---
PORT=8080
APP_ENV=development

# --- Supabase PostgreSQL (Transaction Pooler Port 6543 แนะนำสำหรับ Cloud Run) ---
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Supabase Storage (ใช้ Service Role Key เฉพาะฝั่ง Go Backend เท่านั้น) ---
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=ticket-photos

# --- JWT Authentication (ต้องยาวอย่างน้อย 16 ตัวอักษร แนะนำ 32+ ตัวอักษรแบบสุ่ม) ---
JWT_SECRET=change-this-to-a-very-long-random-secret-string-at-least-32-chars
JWT_EXPIRY_HOURS=24

# --- CORS & Frontend Link (ใส่ URL ของ GitHub Pages เมื่อนำขึ้นใช้งานจริง) ---
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Telegram Bot Notification (แจ้งเตือนเฉพาะเมื่อมีใบแจ้งซ่อมใหม่เท่านั้น) ---
TELEGRAM_BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890

# --- Anti-Spam & Upload Constraints ---
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MINUTES=15
MAX_PHOTO_SIZE_BYTES=524288
